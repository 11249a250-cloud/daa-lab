#include <stdio.h>

#define MAX_ITEMS 100
#define BIN_CAPACITY 10

int firstFit(int weights[], int n) {
    int binCount = 0;
    int binRemaining[MAX_ITEMS];

    for (int i = 0; i < n; i++) {
        int j;
        for (j = 0; j < binCount; j++) {
            if (binRemaining[j] >= weights[i]) {
                binRemaining[j] -= weights[i];
                break;
            }
        }
        if (j == binCount) {
            binRemaining[binCount] = BIN_CAPACITY - weights[i];
            binCount++;
        }
    }
    return binCount;
}

int main() {
    int n, weights[MAX_ITEMS];

    printf("Enter number of items: ");
    scanf("%d", &n);

    printf("Enter weights of items:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &weights[i]);
    }

    int bins = firstFit(weights, n);

    printf("\nFirst Fit requires %d bins.\n", bins);

    return 0;
}
